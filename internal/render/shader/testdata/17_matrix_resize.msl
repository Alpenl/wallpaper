#include <metal_stdlib>
using namespace metal;
float2x2 wp_mat2(float s) { return float2x2(s); }
float3x3 wp_mat3(float s) { return float3x3(s); }
float4x4 wp_mat4(float s) { return float4x4(s); }
float2x2 wp_constructor0(float2 a0, float a1, float a2) { return float2x2(float2(float(a0.x), float(a0.y)), float2(float(a1), float(a2))); }

float4x4 wp_constructor1(float2x2 a0) { return float4x4(float4(a0[0][0], a0[0][1], 0.0, 0.0), float4(a0[1][0], a0[1][1], 0.0, 0.0), float4(0.0, 0.0, 1.0, 0.0), float4(0.0, 0.0, 0.0, 1.0)); }

float3x3 wp_constructor2(float4x4 a0) { return float3x3(float3(a0[0][0], a0[0][1], a0[0][2]), float3(a0[1][0], a0[1][1], a0[1][2]), float3(a0[2][0], a0[2][1], a0[2][2])); }
struct WPShader {
float3 iResolution; float iTime; float iTimeDelta; int iFrame; float4 iMouse; float4 iDate; float iAudioLevel; constant float4* wp_audio;
void mainImage(thread float4 &c, float2 p) {
float2x2 base = wp_constructor0(float2(1.0, 2.0), 3.0, 4.0);
float4x4 large = wp_constructor1(base);
float3x3 reduced = wp_constructor2(large);
float3 col = reduced[1];
(c = float4(col, 1.0));
}
void wp_init() {;}
};
struct WPUniforms { float4 resolutionTime; float4 deltaFrame; float4 mouse; float4 date; float4 wp_audio[128]; };
vertex float4 wp_vertex(uint id [[vertex_id]]) { return float4(id == 1 ? 3.0 : -1.0, id == 2 ? 3.0 : -1.0, 0.0, 1.0); }
fragment float4 wp_fragment(float4 pos [[position]], constant WPUniforms &u [[buffer(0)]]) {
 WPShader s; s.iResolution=u.resolutionTime.xyz; s.iTime=u.resolutionTime.w; s.iTimeDelta=u.deltaFrame.x; s.iFrame=as_type<int>(u.deltaFrame.y); s.iMouse=u.mouse; s.iDate=u.date; s.iAudioLevel=u.deltaFrame.z; s.wp_audio=u.wp_audio;
 s.wp_init(); float4 color=float4(0.0); s.mainImage(color,float2(pos.x,u.resolutionTime.y-pos.y)); return color;
}
