{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wpk/manifest.v0.schema.json",
  "title": "wpk manifest v0",
  "type": "object",
  "required": ["format", "schema", "id", "version", "type", "entry", "title"],
  "properties": {
    "format": {"const": "wpk"},
    "schema": {"const": 0},
    "minApp": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "version": {"type": "integer", "minimum": 1},
    "type": {"enum": ["video", "web", "shader", "image"]},
    "entry": {"type": "string", "pattern": "^content/(?!.*(^|/)\\.\\.(/|$))[^\\\\:*?\"<>|\\u0000]+$", "maxLength": 512},
    "title": {"$ref": "#/$defs/i18n"},
    "description": {"$ref": "#/$defs/i18n"},
    "author": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "maxLength": 128}, "url": {"type": "string", "format": "uri"}}},
    "license": {"type": "string", "maxLength": 64},
    "tags": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 32}},
    "video": {"type": "object", "properties": {
      "loop": {"type": "boolean", "default": true}, "durationSec": {"type": "number", "exclusiveMinimum": 0},
      "w": {"type": "integer", "minimum": 16, "maximum": 16384}, "h": {"type": "integer", "minimum": 16, "maximum": 16384},
      "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
      "codec": {"enum": ["h264", "hevc", "av1", "vp9", "prores", "other"]}, "hasAudio": {"type": "boolean"}}},
    "web": {"type": "object", "properties": {
      "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["network", "audio-reactive"]}},
      "networkAllow": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
      "fpsCap": {"type": "integer", "enum": [15, 24, 30, 60]}, "transparent": {"type": "boolean", "default": false}}},
    "shader": {"type": "object", "required": ["dialect"], "properties": {
      "dialect": {"const": "shadertoy-glsl"}, "passes": {"type": "array", "maxItems": 1, "items": {"type": "string"}}}},
    "properties": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/prop"}},
    "perf": {"type": "object", "properties": {
      "maxFps": {"type": "integer", "minimum": 1, "maximum": 240},
      "minRenderScale": {"type": "number", "minimum": 0.25, "maximum": 1},
      "allowBattery": {"type": "boolean", "default": true}}},
    "origin": {"type": "object", "properties": {"kind": {"enum": ["native", "lively", "we"]}, "ref": {"type": "string"}}}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "video"}}}, "then": {"required": ["video"]}},
    {"if": {"properties": {"type": {"const": "web"}}}, "then": {"required": ["web"]}},
    {"if": {"properties": {"type": {"const": "shader"}}}, "then": {"required": ["shader"]}}
  ],
  "$defs": {
    "i18n": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z]{2}(-[A-Z][A-Za-z]{1,3})?$"}, "additionalProperties": {"type": "string", "maxLength": 2000}},
    "prop": {"type": "object", "required": ["key", "type", "default"],
      "properties": {"key": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
        "type": {"enum": ["slider", "bool", "select", "color", "text"]}, "label": {"$ref": "#/$defs/i18n"}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "slider"}}}, "then": {"required": ["min", "max"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "step": {"type": "number"}, "default": {"type": "number"}}}},
        {"if": {"properties": {"type": {"const": "bool"}}}, "then": {"properties": {"default": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"const": "select"}}}, "then": {"required": ["options"], "properties": {"options": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["value"]}}}}},
        {"if": {"properties": {"type": {"const": "color"}}}, "then": {"properties": {"default": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}}},
        {"if": {"properties": {"type": {"const": "text"}}}, "then": {"properties": {"default": {"type": "string"}, "maxLength": {"type": "integer", "maximum": 2000}}}}
      ]}
  }
}
