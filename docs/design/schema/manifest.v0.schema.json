{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wpk/manifest.v0.schema.json",
  "title": "wpk manifest v0",
  "type": "object",
  "required": ["format", "schema", "id", "version", "type", "entry", "title"],
  "properties": {
    "format": {"const": "wpk"},
    "schema": {"const": 0},
    "minApp": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "version": {"type": "integer", "minimum": 1},
    "type": {"enum": ["video", "image"]},
    "entry": {"type": "string", "pattern": "^content/(?!.*(^|/)\\.\\.(/|$))[^\\\\:*?\"<>|\\u0000]+$", "maxLength": 512},
    "title": {"$ref": "#/$defs/i18n"},
    "description": {"$ref": "#/$defs/i18n"},
    "author": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "maxLength": 128}, "url": {"type": "string", "format": "uri"}}},
    "license": {"type": "string", "maxLength": 64},
    "tags": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 32}},
    "video": {"type": "object", "properties": {
      "loop": {"type": "boolean", "default": true}, "durationSec": {"type": "number", "exclusiveMinimum": 0},
      "w": {"type": "integer", "minimum": 16, "maximum": 16384}, "h": {"type": "integer", "minimum": 16, "maximum": 16384},
      "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
      "codec": {"enum": ["h264", "hevc", "av1", "vp9", "prores", "other"]}, "hasAudio": {"type": "boolean"}}},
    "origin": {"type": "object", "properties": {"kind": {"enum": ["native", "lively", "we"]}, "ref": {"type": "string"}}}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "video"}}}, "then": {"required": ["video"]}}
  ],
  "$defs": {
    "i18n": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z]{2}(-[A-Z][A-Za-z]{1,3})?$"}, "additionalProperties": {"type": "string", "maxLength": 2000}}
  }
}
